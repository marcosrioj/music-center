{
  "name": "musiccenter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @musiccenter/web --",
    "build": "npm run build --workspace @musiccenter/web",
    "sync": "npm run sync --workspace @musiccenter/mobile",
    "android": "npm run android --workspace @musiccenter/mobile",
    "ios": "npm run ios --workspace @musiccenter/mobile",
    "apk": "npm run apk --workspace @musiccenter/mobile",
    "supabase": "npm run supabase --workspace @musiccenter/backend --",
    "test:online": "npm run test:online --workspace @musiccenter/backend",
    "package:web": "npm run build && python3 scripts/package-web.py",
    "package:ios": "npm run sync && python3 scripts/package-ios.py",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "npm run check:architecture && npm test --workspace @musiccenter/web && npm test --workspace @musiccenter/backend"
  }
}
