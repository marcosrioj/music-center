{
  "name": "musiccenter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:online": "node scripts/test-online.mjs",
    "package:web": "npm run build && python3 scripts/package-web.py"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
